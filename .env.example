# ============================================================
# Telegram Query configuration
# Copy this file to .env and fill in your values.
# Everything without a default is optional; the app tells you
# what is missing through the first-run wizard.
# ============================================================

# --- Telegram ------------------------------------------------
# API credentials: https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Where the Telegram session and the message database live.
# Leave unset to use the data/ directory next to the app.
# TG_SESSION_PATH=data/tg_session
# TG_DB_PATH=data/messages.db
# TG_DATA_DIR=data

# Re-scan window (days) used by the "Sync" button to catch edits
SYNC_DAYS=3

# --- AI provider (optional) ----------------------------------
# Any OpenAI-compatible chat-completions endpoint: OpenAI, Azure
# OpenAI, Groq, Together, OpenRouter, Ollama, LM Studio, vLLM...
# Ask-AI features stay disabled until AI_API_KEY is set.
# NOTE: AI answers send retrieved message excerpts to this endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
# Max messages sent to the model as context per question
AI_MAX_SOURCES=80

# Optional model routing (v0.7): different price/quality tiers for the
# same endpoint. Unset roles fall back to AI_MODEL.
# AI_MODEL_EXTRACT=llama-3.1-8b-instant   # cheap/fast structured tasks
#                                          # (deals, entities, keywords)
# AI_MODEL_SYNTH=llama-3.3-70b-versatile  # answers, briefs, digests,
#                                          # timelines
# AI_MODEL_EMBED=  # reserved for the (benchmark-gated) hybrid retrieval
# Hard daily AI request cap (UTC). 0 = unlimited. Deterministic features
# (search, watchlists, discovery, sync) are never affected - AI features
# just fail with honest errors until the cap resets.
# TGQ_AI_DAILY_CAP=0
# Max provider requests in flight at once (default 4). Extra asks wait up
# to the request timeout, then fail with an honest busy error - this
# protects the server when the provider is slow, without affecting
# deterministic features.
# TGQ_AI_MAX_CONCURRENCY=4

# Optional free-text description of your groups, e.g.
# "car-owner communities and local deal groups" - helps the model
# pick better keywords. Shown only to the AI keyword extractor.
# TGQ_GROUPS_HINT=

# --- Search normalization (v0.4) -----------------------------
# extended (default): Arabic-Indic digits (٢٥->25), elongation collapse
# (هااااي->هاي), Arabizi digit folding inside Latin words, and a small
# Gulf-dialect word map (شلون->كيف). standard: exact v0.3 behavior.
# Changing the level requires a one-time reindex (Settings -> Rebuild
# search index, or it is scheduled automatically after an upgrade).
# NORMALIZATION=extended
# Optional JSON override for the dialect word map, e.g.
# {"هلق":"الان"}  (replaces the built-in Gulf map entirely)
# TGQ_DIALECT_MAP=

# --- Desktop runtime (packaged builds, v1.0) -------------------
# Everything below is honored by the packaged app (TelegramQuery.exe);
# source runs use the defaults shown.
# Where mutable data lives. Packaged default: %LOCALAPPDATA%\TelegramQuery
# (never inside Program Files). Source default: <repo>/data
# TG_DATA_DIR=data
# How the app presents its UI. Default: a native app window (needs the
# Microsoft Edge WebView2 Runtime - preinstalled on Windows 10/11;
# a missing runtime shows an error dialog and exits).
# "window" = native app window (default)
# "none"   = start with no UI at all (TGQ_NO_WINDOW=1 or --no-window;
#             the packaged-app test uses this; --no-browser and
#             TGQ_NO_BROWSER stay honored as legacy aliases)
# TGQ_NO_WINDOW=1
# Seconds to wait for the backend health check before showing the
# startup-failed dialog (default 60, minimum 5)
# TGQ_STARTUP_TIMEOUT=60
# Optional port override for the local server (a busy port always falls
# back to a free one - the actual port lands in <data>/runtime.json)
# PORT=8000

# --- Server --------------------------------------------------
# Keep 127.0.0.1 unless you understand the security implications:
# the API has no authentication and exposes your message archive.
HOST=127.0.0.1
PORT=8000
# LOG_LEVEL=INFO
