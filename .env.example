# ============================================================
# Telegram Query configuration
# Copy this file to .env and fill in your values.
# Everything without a default is optional; the app tells you
# what is missing through the first-run wizard.
# ============================================================

# --- Telegram ------------------------------------------------
# API credentials: https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Where the Telegram session and the message database live.
# Leave unset to use the data/ directory next to the app.
# TG_SESSION_PATH=data/tg_session
# TG_DB_PATH=data/messages.db
# TG_DATA_DIR=data

# Re-scan window (days) used by the "Sync" button to catch edits
SYNC_DAYS=3

# --- AI provider (optional) ----------------------------------
# Any OpenAI-compatible chat-completions endpoint: OpenAI, Azure
# OpenAI, Groq, Together, OpenRouter, Ollama, LM Studio, vLLM...
# Ask-AI features stay disabled until AI_API_KEY is set.
# NOTE: AI answers send retrieved message excerpts to this endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
# Max messages sent to the model as context per question
AI_MAX_SOURCES=80

# Optional free-text description of your groups, e.g.
# "car-owner communities and local deal groups" - helps the model
# pick better keywords. Shown only to the AI keyword extractor.
# TGQ_GROUPS_HINT=

# --- Server --------------------------------------------------
# Keep 127.0.0.1 unless you understand the security implications:
# the API has no authentication and exposes your message archive.
HOST=127.0.0.1
PORT=8000
# LOG_LEVEL=INFO
