# secrets / personal data
.env
ROADMAP.md

# telegram session files (any location)
tg_session*
*.session

# databases (any location) - includes bench + backup outputs under data/
messages.db
messages.db-*
data/

# engineering bench artifacts (benchmark JSON dumps; the reports in
# docs/engineering/ are tracked, their raw data is reproducible)
docs/engineering/*.json

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# node / vite (web/dist IS committed: end users run without node)
web/node_modules/
web/.vite/
npm-debug.log*

# logs / os noise
logs/
*.log
.DS_Store
Thumbs.db

# packaging build outputs (release artifacts are produced per build,
# never committed: PyInstaller onedir, WiX intermediates, MSI/EXE).
# Anchored to the repo root - web/dist stays tracked on purpose.
/build/
/dist/

# downloaded WiX toolset binaries (scripts/build_windows.py fetches them)
packaging/windows/tools/
