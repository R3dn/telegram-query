<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Telegram Query"
           Language="1033"
           Version="@@VERSION@@"
           Manufacturer="Telegram Query"
           UpgradeCode="@@UPGRADE_GUID@@">
    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64" />
    <!-- AllowSameVersionUpgrades: rebuilt artifacts with the same
         version (RC cycles, packaging fixes) must still replace the
         installed product instead of installing side-by-side and
         leaving stale hashed assets behind. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Telegram Query is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="@@ICON@@" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/telegramquery/telegram-query" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- When the Burn bundle chains this MSI it passes TGQBUNDLED=1:
        the MSI's Add/Remove-Programs entry is then marked SystemComponent
        (hidden) because the bundle already registers one. A direct
        msiexec install never sets TGQBUNDLED, so its entry stays
        visible - exactly one entry either way. -->
    <SetProperty Id="ARPSYSTEMCOMPONENT" Value="1"
                 Before="AppSearch" Sequence="first">TGQBUNDLED</SetProperty>


    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="TelegramQuery">
          <!-- Files are harvested by heat into DirectoryRef INSTALLDIR -->
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Telegram Query" />
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="Telegram Query" Level="1">
      <ComponentGroupRef Id="TelegramQueryFiles" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Component Id="DesktopShortcut"
               Directory="DesktopFolder"
               Guid="*">
      <Shortcut Id="DesktopShortcut"
                Name="Telegram Query"
                Target="[INSTALLDIR]TelegramQuery.exe"
                WorkingDirectory="INSTALLDIR"
                Icon="AppIcon" />
      <RegistryValue Root="HKMU"
                      Key="Software\TelegramQuery"
                      Name="DesktopShortcut"
                      Type="integer"
                      Value="1"
                      KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut"
               Directory="ApplicationProgramsFolder"
               Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="Telegram Query"
                Target="[INSTALLDIR]TelegramQuery.exe"
                WorkingDirectory="INSTALLDIR"
                Icon="AppIcon" />
      <RemoveFolder Id="ApplicationProgramsFolder"
                    On="uninstall" />
      <RegistryValue Root="HKMU"
                      Key="Software\TelegramQuery"
                      Name="StartMenuShortcut"
                      Type="integer"
                      Value="1"
                      KeyPath="yes" />
    </Component>
  </Product>
</Wix>
